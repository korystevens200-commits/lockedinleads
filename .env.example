# =============================================================================
# LockedinLeads configuration
#
# Copy to .env and fill in what you need. .env is gitignored — never commit it.
# Everything has a safe default: with an empty .env the app runs fully in
# simulated mode (built-in AI engine, logged emails/SMS, mock billing).
#
#   cp .env.example .env && python3 server.py
# =============================================================================

# --- Core ---------------------------------------------------------------
# APP_ENV=production turns on secure cookies and REQUIRES SECRET_KEY.
APP_ENV=development
PORT=8420
# Public base URL. Used in webhook URLs, chat links and notification emails.
PUBLIC_URL=http://localhost:8420

# Signs sessions. REQUIRED in production — the app refuses to start without it.
# Generate:  python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where the SQLite database lives. On Fly/Render point this at a mounted volume.
DB_PATH=

# --- First agency admin account -----------------------------------------
# Created once, on first boot. If ADMIN_PASSWORD is blank a random one is
# generated and printed to the console exactly once.
AGENCY_NAME=LockedinLeads
ADMIN_EMAIL=admin@lockedinleads.local
ADMIN_PASSWORD=

# --- AI provider ---------------------------------------------------------
# Without a key the built-in rules engine runs the full conversation, so the
# product works end-to-end (including the demo) with no AI credentials at all.
# Add a key to switch to Claude. Requires: pip install -r requirements.txt
AI_PROVIDER=auto          # auto | anthropic | rules
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_EFFORT=low             # low | medium | high | xhigh | max
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=45

# --- Email notifications (SMTP) -----------------------------------------
# Blank = simulated (logged to the outbound log and visible in the dashboard).
# Gmail: smtp.gmail.com / 587 / your address / a 16-char App Password
# (https://myaccount.google.com/apppasswords, needs 2-Step Verification on).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- SMS notifications (Twilio) -----------------------------------------
# Blank = simulated. Needed to text leads (rather than email them) and to text
# the owner when a lead books.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Billing (Stripe) ----------------------------------------------------
# Blank = mock mode: plan changes are recorded locally, no card is charged.
# The secret key never leaves the server; only the publishable key reaches the
# browser, and only for signed-in users.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-plan Stripe price IDs are set in the agency console under Plans.

# --- Automation worker ---------------------------------------------------
WORKER_ENABLED=true
WORKER_INTERVAL_SECONDS=20

# --- Demo & marketing ----------------------------------------------------
# Seeds the "Sparkle & Shine Cleaning Co." demo account on first boot.
SEED_DEMO=true
# Where the landing page's "Book a Demo" button points.
DEMO_BOOKING_URL=https://calendly.com/korystevens200
CONTACT_EMAIL=

# Session lifetime in seconds (default 14 days).
SESSION_TTL_SECONDS=1209600
