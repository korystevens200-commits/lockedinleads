# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# --- Dashboard login (Basic Auth) ---
# Required before deploying anywhere public. Pick your own values.
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=changeme

# --- Owner email notifications ---
# Leave blank to keep notifications simulated (logged to data/email_log.jsonl).
# Gmail App Password: smtp.gmail.com, port 587, SMTP_USER = your Gmail address,
# SMTP_PASSWORD = a 16-character App Password (not your regular Gmail password) —
# generate one at https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
OWNER_EMAIL=

# --- Server port (hosting platforms usually set this automatically) ---
PORT=8420
